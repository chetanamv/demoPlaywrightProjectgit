
pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Playwright Shards') {
            parallel {
                stage('Shard 1') {
                    agent any

                    steps {
                        catchError(
                            buildResult: 'FAILURE',
                            stageResult: 'FAILURE'
                        ) {
                            checkout scm
                            bat 'npm ci'
                            bat 'npx playwright install chromium'
                            bat 'npx playwright test --shard=1/2'
                        }
                    }

                    post {
                        always {
                            stash(
                                name: 'shard1-blob',
                                includes: 'blob-report/**',
                                allowEmpty: true
                            )
                        }
                    }
                }

                stage('Shard 2') {
                    agent any

                    steps {
                        catchError(
                            buildResult: 'FAILURE',
                            stageResult: 'FAILURE'
                        ) {
                            checkout scm
                            bat 'npm ci'
                            bat 'npx playwright install chromium'
                            bat 'npx playwright test --shard=2/2'
                        }
                    }

                   
                }
                  
                }
            }
        }

        stage('Merge Reports') {
            agent any

            steps {
                checkout scm
                bat 'npm ci'

                // Collect reports from all four shards.
                unstash 'shard1-blob'
                unstash 'shard2-blob'
              

                // Merge available Blob reports into HTML.
                bat '''
                    if exist blob-report\\*.zip (
                        npx playwright merge-reports --reporter html blob-report
                    ) else (
                        echo No Blob reports were generated.
                    )
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'blob-report/**,playwright-report/**',
                        allowEmptyArchive: true
                    )

                    publishHTML(target: [
                        reportName: 'Playwright Combined Report',
                        reportDir: 'playwright-report',
                        reportFiles: 'index.html',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ])
                }
            }
        }
    }
}

