
pipeline {
    agent any

    options {
        timestamps()
    }
    // Application URL entered when starting the Jenkins build
    parameters {
        string(
            name: 'BASE_URL',
            defaultValue: 'https://www.automationexercise.com/',
            description: 'Application URL'
        )
    }

    stages {

        stage('Playwright Shards') {

            parallel {

                stage('Shard 1') {
                    agent any

                    steps {
                        catchError(
                            buildResult: 'FAILURE',
                            stageResult: 'FAILURE'
                        ) {
                            checkout scm

                            bat 'npm ci'
                            bat 'npx playwright install chromium'
                            // Get email and password from Jenkins Credentials
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'cf013a30-3502-4874-a5de-1a168ca4c62c',
                                    usernameVariable: 'EMAIL',
                                    passwordVariable: 'PASSWORD'
                                )
                            ])
                            bat 'npx playwright test --shard=1/2 --reporter=blob'
                        }
                    }

                    post {
                        always {
                            stash(
                                name: 'shard1-blob',
                                includes: 'blob-report/**',
                                allowEmpty: true
                            )
                        }
                    }
                }

                stage('Shard 2') {
                    agent any

                    steps {
                        catchError(
                            buildResult: 'FAILURE',
                            stageResult: 'FAILURE'
                        ) {
                            checkout scm

                            bat 'npm ci'
                            bat 'npx playwright install chromium'
                            // Get email and password from Jenkins Credentials
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'cf013a30-3502-4874-a5de-1a168ca4c62c',
                                    usernameVariable: 'EMAIL',
                                    passwordVariable: 'PASSWORD'
                                )
                            ])

                            {bat 'npx playwright test --shard=1/2 --reporter=blob'}
                        }
                    }

                    post {
                        always {
                            stash(
                                name: 'shard2-blob',
                                includes: 'blob-report/**',
                                allowEmpty: true
                            )
                        }
                    }
                }
            }
        }

        stage('Merge Reports') {

            agent any

            steps {
                checkout scm

                bat 'npm ci'

                // Retrieve reports from both shards
                unstash 'shard1-blob'
                unstash 'shard2-blob'

                // Merge Blob reports into HTML
                bat '''
                    if exist blob-report\\*.zip (
                        npx playwright merge-reports --reporter=html blob-report
                    ) else (
                        echo No Blob reports were generated.
                    )
                '''
            }

            post {
                always {

                    archiveArtifacts(
                        artifacts: 'blob-report/**,playwright-report/**',
                        allowEmptyArchive: true
                    )

                    publishHTML(target: [
                        reportName: 'Playwright Combined Report',
                        reportDir: 'playwright-report',
                        reportFiles: 'index.html',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: true
                    ])
                }
            }
        }
    }
}
